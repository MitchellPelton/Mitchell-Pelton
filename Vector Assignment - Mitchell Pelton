#include <iostream>
using namespace std;
#include <vector>

int main()
{
	
	//The purpose of this section of code is to create a vector and add some initial values to it.
	
	vector<int> numbers ;
	numbers.push_back(10);
	numbers.push_back(20);
	numbers.push_back(30);


	//The purpose of this section of code is to prompt the user to add more values to the vector until they choose to stop.

	int userInput;
	cout << " Please enter a number to add to the vector: " << endl;

	while (true)
	{
		cin >> userInput;
		if (userInput == -1)
		{
			break;
		}
		numbers.push_back(userInput);
		cout << " Please enter another number to add to the vector or -1 to stop: " << endl;
	}

	//The purpose of this section of code is to display all the values in the vector.
	 
	cout << "The numbers in the vector are: " << endl;
	for (int i = 0; i < numbers.size(); i++)
	{
		cout << numbers[i] << endl;
	}
	return 0;

    
}

