#include <iostream>
using namespace std;


// The purpose of this code is to take two integer pointers as input and swap the values they point to.

int swap_values(int* a, int* b) {
	int temp = *a; 
	*a = *b;      
	*b = temp;    
	return 0;     
}

int main()
{
	int x = 5; 
	int y = 10; 
	cout << "Before swapping: x = " << x << ", y = " << y << endl; 
	swap_values(&x, &y); 
	cout << "After swapping: x = " << x << ", y = " << y << endl; 
	return 0; 
   
}
